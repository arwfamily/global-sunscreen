{"id": "CA:NPN-80024807", "id_scheme": "npn", "jurisdiction": "CA", "authority": "Health Canada NNHPD (LNHPD)", "regulatory_class": "natural_health_product", "source_product_key": 19526169, "product_name": "SUN 20 SPF Neutral Sun Screen", "company": "Lavera Skin Care North America Inc.", "dosage_form": "Lotion", "routes": ["Topical"], "purposes": ["Sun Protection Factor 20, SPF 20. Sunburn protectant, sunscreen. Helps prevent, or protects, from sunburn. Filters or screens certain of the sun's harmful ultraviolet or UV rays to help prevent sunburn. Give sunburn protection. UVA/UVB sunburn protection, UVA/UVB protection. Broad spectrum UVA/UVB protection, broad spectrum protection against UVA/UVB rays. Absorbs throughout the UVA/UVB spectrum to provide sunburn protection. Protects against UVA/UVB rays. The sun may cause sunburn, premature aging of the skin and skin cancer. Avoiding the sun, wearing protective clothing and regular use of sunscreens over the years may reduce the chance of these harmful effects."], "actives": [{"name": "Zinc oxide", "quantity": 18.0, "unit": "percent", "quantity_min": 0.0, "quantity_max": 0.0, "potency_amount": 0.0, "potency_constituent": "", "potency_unit": "", "source_material": "Zinc oxide"}, {"name": "Titanium dioxide", "quantity": 8.0, "unit": "percent", "quantity_min": 0.0, "quantity_max": 0.0, "potency_amount": 0.0, "potency_constituent": "", "potency_unit": "", "source_material": "Titanium dioxide"}], "inactives": ["Dipotassium glycyrrhizate", "Polyglyceryl-3 Ricinoleate", "Glycine Soja (Soybean) Seed Extract", "Stearic acid", "Lear oil", "Tocopherol", "Beta-Glucan", "Alumina", "Hippophae Rhamnoides Extract", "Tricaprylin", "Glycerin", "Aloe barbadensis leaf juice", "Glyceryl oleate", "Helianthus Annuus (Sunflower) Seed Oil", "Oenothera Biennis (Evening Primrose) Oil", "Alcohol", "Glucose glutamate", "Buxus Chinensis Oil", "Ascorbyl palmitate", "Aqua", "Hydrogenated castor oil", "d-alpha Tocopheryl acetate"], "populations": ["Sub