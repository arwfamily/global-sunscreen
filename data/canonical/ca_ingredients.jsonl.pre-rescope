{"id": "CA:NPN-80026736", "id_scheme": "npn", "jurisdiction": "CA", "authority": "Health Canada NNHPD (LNHPD)", "regulatory_class": "natural_health_product", "source_product_key": 19646133, "product_name": "Dual Protection Day Lotion", "company": "Own Products, Inc.", "dosage_form": "Lotion", "routes": ["Topical"], "purposes": ["Helps prevent sunburn. SPF 30. The sun may cause sunburn, premature aging of the skin and skin cancer.  Avoiding the sun, wearing protective clothing and regular use of sunscreens over the years may reduce the chance of these harmful effects. Mineral sunscreen provides UVA/UVB sunburn protection."], "actives": [{"name": "Zinc oxide", "quantity": 11.2875, "unit": "%", "quantity_min": 0.0, "quantity_max": 0.0, "potency_amount": 0.0, "potency_constituent": "", "potency_unit": "", "source_material": "Zinc oxide"}, {"name": "Titanium dioxide", "quantity": 1.1, "unit": "%", "quantity_min": 0.0, "quantity_max": 0.0, "potency_amount": 0.0, "potency_constituent": "", "potency_unit": "", "source_material": "Titanium dioxide"}], "inactives": ["Polyhydroxystearic Acid", "Cyclopentasiloxane", "Phenoxyethanol", "Carthamus Tinctorius Oleosomes", "Coco-caprylate/caprate", "Glyceryl Isostearate", "Cetearyl Alcohol", "Sorbitan Olivate", "Citric acid", "Hordeum Distichon (Barley) Extract", "Glycerin", "Dimethicone", "Aqua", "Squalane", "Santalum Album (Sandalwood) Oil", "Hydroxyethyl Acrylate/Sodium Acryloyldimethyl Taurate Copolymer", "Polysorbate 60", "Caprylic/capric triglyceride", "Ethylhexylglycerin", "Phellodendron Amurense Bark Extract", "d-alpha tocopherol", "Cetearyl Olivate", "Cetearyl glucoside"], "populations": ["Sub Population N/A"], "licence_date": "2011-08-05", "revised_date": null, "status_active": true, "attested_monograph": false, "scope": "sunscreen", "source_url": "https://health-products.canada.ca/lnhpd-bdpsnh/info?licence=80026736", "uv_filters": ["titanium dioxide", "zinc oxide"], "mineral_only": true, "formulation_hash": "1ada47c5848beda2", "n_actives": 2, "n_inactives": 23, "verified_at": "2026-08-26", "first_seen": "2026-08-26"}
{"id": "CA:NPN-80026792", "id_scheme": "npn", "jurisdiction": "CA", "authority": "Health Canada NNHPD (LNHPD)", "regulatory_class": "natural_health_product", "source_product_key": 19645665, "product_name": "eco FACE SPF 30+", "company": "Eco Skin Care", "dosage_form": "Lotion", "routes": ["Topical"], "purposes": ["Sun Protection Factor 30. SPF 30. Sunburn protectant, sunscreen. Helps prevent, or protects, from sunburn. Filters or screens certain of the sun's harmful ultraviolet or UV rays to help prevent sunburn. Gives sunburn protection. UVA/UVB sunburn protection, UVA/UVB protection. Broad spectrum UVA/UVB protection, broad spectrum protection against UVA/UVB rays. Absorbs throughout the UVA/UVB spectrum to provide sunburn protection. Protects against UVA/UVB rays. The sun may cause sunburn, premature aging of the skin and skin cancer. Avoiding the sun, wearing protective clothing and regular use of sunscreens over the years may reduce the chance of these harmful effects."], "actives": [{"name": "Zinc oxide", "quantity": 20.0, "unit": "%", "quantity_min": 0.0, "quantity_max": 0.0, "potency_amount": 0.0, "potency_constituent": "", "potency_unit": "", "source_material": "Zinc oxide"}], "inactives": ["Caprylic/capric triglyceride", "Sorbitan stearate", "Hydroxypropyl starch phosphate", "Purified water", "Cetearyl glucoside", "Caprylyl Glycol", "Cetearyl Alcohol", "Cucumis Sativus (Cucumber) Seed Extract", "Xanthan Gum", "Sucrose cocoate", "Green tea extract", "Isoamyl laurate", "Polyhydroxystearic Acid"], "populations": ["Sub Population N/A"], "licence_date": "2011-08-09", "revised_date": null, "status_active": true, "attested_monograph": false, "scope": "sunscreen", "source_url": "https://health-products.canada.ca/lnhpd-bdpsnh/info?licence=80026792", "uv_filters": ["zinc oxide"], "mineral_only": true, "formulation_hash": "5c77ed2903c91454", "n_actives": 1, "n_inactives": 13, "verified_at": "2026-08-26", "first_seen": "2026-08-26"}
