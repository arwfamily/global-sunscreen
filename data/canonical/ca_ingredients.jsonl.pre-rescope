{"id": "CA:NPN-80043703", "id_scheme": "npn", "jurisdiction": "CA", "authority": "Health Canada NNHPD (LNHPD)", "regulatory_class": "natural_health_product", "source_product_key": 20260149, "product_name": "Lotion solaire FPS 30", "company": "Laboratoire Sol-Labo Inc.", "dosage_form": "Lotion", "routes": ["Topical"], "purposes": ["F.P.S. 30. Agent de protection contre le soleil; aide à prévenir les coups de soleil. Bloque les rayons UVA et UVB nocifs. Écran solaire. Absorbe la totalité du spectre UVA et UVB afin de protéger contre les coups de soleil. Le soleil peut causer des coups de soleil, un vieillissement prématuré de la peau et le cancer de la peau.  Le fait d'éviter l'exposition au soleil, le port de vëtements protecteurs et l'usage régulier d'écrans solaires peut, avec les années, réduire le risque de ces effets nocifs."], "actives": [{"name": "Zinc oxide", "quantity": 15.0, "unit": "%", "quantity_min": 0.0, "quantity_max": 0.0, "potency_amount": 0.0, "potency_constituent": "", "potency_unit": "", "source_material": "Zinc oxide"}], "inactives": ["Glycerin", "Polyglyceryl-2 dipolyhydroxystearate", "Cocoglycerides", "Propylene glycol", "Isostearyl Isostearate", "Polyhydroxystearic acid", "Triethoxycaprylylsilane", "Water", "Sunflower Oil", "Glyceryl Isostearate", "Caprylic/Capric triglyceride", "Methylcellulose", "Isopropyl myristate", "PPG-3 Benzyl Ether Myristate", "Hydroxyapatite", "Iodopropynyl butylcarbamate", "Dimethicone", "Diazolidinyl Urea"], "populations": ["Adults and Children"], "licence_date": "2013-07-17", "revised_date": null, "status_active": true, "attested_monograph": false, "scope": "sunscreen", "source_url": "https://health-products.canada.ca/lnhpd-bdpsnh/info?licence=80043703", "uv_filters": ["zinc oxide"], "mineral_only": true, "baby": true, "baby_flag_source": "population", "formulation_hash": "bd0aff2bafccae84", "n_actives": 1, "n_inactives": 18, "verified_at": "2026-08-26", "first_seen": "2026-08-26"}
