{"id": "CA:NPN-80043241", "id_scheme": "npn", "jurisdiction": "CA", "authority": "Health Canada NNHPD (LNHPD)", "regulatory_class": "natural_health_product", "source_product_key": 20157111, "product_name": "Moisturizing Day Cream SPF 15", "company": "Isagenix Canada ULC", "dosage_form": "Cream", "routes": ["Topical"], "purposes": ["SPF 15. Sunburn protectant - helps prevent or protects from sunburn. Sunscreen. Filters/screens harmful UVA/UVB rays. Absorbs throughout the UVA/UVB spectrum to provide sunburn protection. Spending time in the sun increases your risk of skin cancer and early skin aging. To decrease this risk, regularly use a sunscreen with a Broad Spectrum SPF value of 15 or higher and other sun protection measures including: limit time in the sun, especially from 10 a.m.-2 p.m and wear long-sleeved shirts, pants, hats, and sunglasses. The sun may cause sunburn, premature aging of the skin and skin cancer. Avoiding the sun, wearing protective clothing and regular use of sunscreens over the years reduces the  chance of these harmful effects. Watch for the UV index. Use shade wisely."], "actives": [{"name": "Zinc oxide", "quantity": 6.5, "unit": "%", "quantity_min": 0.0, "quantity_max": 0.0, "potency_amount": 0.0, "potency_constituent": "", "potency_unit": "", "source_material": "Zinc oxide"}, {"name": "Titanium dioxide", "quantity": 1.0, "unit": "%", "quantity_min": 0.0, "quantity_max": 0.0, "potency_amount": 0.0, "potency_constituent": "", "potency_unit": "", "source_material": "Titanium dioxide"}], "inactives": ["Stearic acid", "Citrus Reticulata (Tangerine) Peel Essential Oil", "Caprylic/capric triglyceride", "Hydroxypropyl Cyclodextrin", "Polyhydroxystearic Acid", "Citrus Grandis Peel Oil", "Sodium lactate", "Water", "Xanthan Gum", "Palmitoyl tripeptide-38", "Vitis Vinifera (Grape) Seed Extract", "PEG-100 stearate", "Caprylyl Glycol", "Pyrus malus (apple) fruit extract", "Jojoba Esters", "Silicon dioxide", "Ceteareth-20", "C12-15 Alkyl Benzoate", "Ethy